generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  PACKED
  DELIVERED
  PARTIALLY_DELIVERED
  PARTIALLY_RETURNED
  COMPLETED
  CANCELLED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  LOANED
  MAINTENANCE
  DISPOSED
}

// RN-INV-30: lista cerrada de seis estados físicos de una unidad.
enum PhysicalState {
  OPERATIVO
  DESCARGADO_AGOTADO
  CON_FALLA
  AVERIADO
  EN_MANTENIMIENTO
  DADO_DE_BAJA
}

// RN-MOV-01: ocho eventos registrados. La pérdida no es un tipo propio: es el motivo de
// una baja (DISPOSAL). LOAN = entrega; RETURN = devolución.
enum MovementType {
  ENTRY
  ASSEMBLY
  DISASSEMBLY
  RESERVATION
  LOAN
  RETURN
  DISPOSAL
  ADJUSTMENT
  RESTOCK
}

// RN-PRE-08 / RN-PRE-10: la condición de retorno tiene dos ejes independientes y cerrados.
enum ReturnFunctioning {
  FUNCIONA
  FUNCIONA_CON_FALLA
  NO_FUNCIONA
}

enum ReturnDamageState {
  SIN_DANO
  DESGASTE_NORMAL
  DANADO
}

// RN-PRE-09: la tarea por daño tiene dos estados y no se reabre.
enum DamageTaskStatus {
  OPEN
  RESOLVED
}

enum NotificationType {
  REQUEST_APPROVED
  REQUEST_REJECTED
  STOCK_LOW
  RETURN_REMINDER
  SYSTEM
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  fullName      String    @db.VarChar(255)
  role          Role
  shift         Shift?
  phone         String?   @db.VarChar(50)
  document      String?   @db.VarChar(100)
  imageUrl      String?   @db.VarChar(500)
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestsMade   Request[]     @relation("RequestRequester")
  requestsApproved Request[]   @relation("RequestApprovedBy")
  requestsRejected Request[]   @relation("RequestRejectedBy")
  requestsPacked   Request[]   @relation("RequestPackedBy")
  requestsDelivered Request[]  @relation("RequestDeliveredBy")
  movements      Movement[]    @relation("MovementResponsible")
  returnedUnits  RequestItemUnit[] @relation("ReturnedByUser")
  lostUnits      RequestItemUnit[] @relation("LostByUser")
  damageTasksCreated  DamageTask[] @relation("DamageTaskCreatedBy")
  damageTasksResolved DamageTask[] @relation("DamageTaskResolvedBy")
  notifications  Notification[]

  @@unique([email, isDeleted])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Environment {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  location    String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests     Request[]
  inventoryUnits InventoryUnit[]

  @@map("environments")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@map("categories")
}

// RN-INV-07 / RN-INV-46: dos tenencias; solo un elemento donado puede ser consumible.
enum Ownership {
  SENA
  DONATED
}

model Item {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  imageUrl     String?  @db.VarChar(500)
  categoryId   Int
  // RN-INV-44: el umbral lo fija el administrador por elemento; si falta (NULL) no hay
  // alerta y el sistema no inventa un valor por defecto.
  minStock     Int?
  unit         String   @default("UNIDAD") @db.VarChar(50)
  isConsumable Boolean  @default(false)
  // RN-INV-07 / RN-INV-46: tenencia del elemento; solo DONATED puede ser consumible.
  ownership    Ownership @default(SENA)
  // RN-INV-06: existencia del consumible controlada por cantidad (no genera unidades).
  stock        Int      @default(0)
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  inventoryUnits InventoryUnit[]
  requestItems   RequestItem[]
  movements      Movement[]
  components     ItemComponent[] @relation("ItemComponentParent")
  usedInComponents ItemComponent[] @relation("ItemComponentChild")

  @@index([categoryId])
  @@index([isActive])
  @@map("items")
}

model InventoryUnit {
  id            Int           @id @default(autoincrement())
  itemId        Int
  serialNumber  String        @unique @db.VarChar(255)
  environmentId Int?
  parentUnitId  Int?
  status        UnitStatus    @default(AVAILABLE)
  physicalState PhysicalState @default(OPERATIVO)
  // RN-INV-20: la tenencia de un equipo serializado vive en la unidad física.
  ownership Ownership @default(SENA)
  // RN-INV-33: trámite de baja abierto (no es estado físico). Bloquea la unidad y sus piezas.
  disposalInProgress Boolean  @default(false)
  // RN-INV-17 / RN-INV-19: motivo y actores de la baja (inmediata o por trámite).
  disposalReason       String?   @db.Text
  disposalStartedAt    DateTime?
  disposalStartedById  Int?
  disposalConfirmedAt  DateTime?
  disposalConfirmedById Int?
  // RN-PRE-15: unidad declarada perdida. Sale del inventario activo y no bloquea; sus
  // piezas sueltas siguen prestables (excepción al bloqueo del trámite).
  declaredLost       Boolean  @default(false)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  item        Item        @relation(fields: [itemId], references: [id])
  environment Environment? @relation(fields: [environmentId], references: [id])
  parentUnit  InventoryUnit? @relation("UnitAssembly", fields: [parentUnitId], references: [id])
  childUnits  InventoryUnit[] @relation("UnitAssembly")
  movements   Movement[]
  requestItemUnits RequestItemUnit[]
  damageTasks DamageTask[]

  @@index([itemId])
  @@index([status])
  @@index([environmentId])
  @@index([parentUnitId])
  @@map("inventory_units")
}

model ItemComponent {
  id           Int      @id @default(autoincrement())
  parentItemId Int
  childItemId  Int
  quantity     Int      @default(1)
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())

  parentItem Item @relation("ItemComponentParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItem  Item @relation("ItemComponentChild", fields: [childItemId], references: [id], onDelete: Cascade)

  @@unique([parentItemId, childItemId])
  @@index([parentItemId])
  @@index([childItemId])
  @@map("item_components")
}

model Request {
  id              Int           @id @default(autoincrement())
  code            String        @unique @db.VarChar(50)
  requesterId     Int
  environmentId   Int?
  shift           String?       @db.VarChar(50)
  status          RequestStatus @default(PENDING)
  requestDate     DateTime      @default(now())
  // RN-SOL-01 / RN-NEG-04: fecha de retiro y rango de reserva [pickupDate, estimatedDate].
  pickupDate      DateTime?
  // RN-SOL-04: nota del administrador cuando aprueba menos de lo solicitado.
  approvalNote    String?       @db.Text
  estimatedDate   DateTime?
  observations    String?       @db.Text
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?       @db.Text
  rejectedById    Int?
  rejectedAt      DateTime?
  packedById      Int?
  packedAt        DateTime?
  deliveredById   Int?
  deliveredAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  requester     User          @relation("RequestRequester", fields: [requesterId], references: [id])
  approvedBy    User?         @relation("RequestApprovedBy", fields: [approvedById], references: [id])
  rejectedBy    User?         @relation("RequestRejectedBy", fields: [rejectedById], references: [id])
  packedBy      User?         @relation("RequestPackedBy", fields: [packedById], references: [id])
  deliveredBy   User?         @relation("RequestDeliveredBy", fields: [deliveredById], references: [id])
  environment   Environment?  @relation(fields: [environmentId], references: [id])
  requestItems  RequestItem[]
  movements     Movement[]

  @@index([requesterId])
  @@index([status])
  @@index([requestDate])
  @@map("requests")
}

model RequestItem {
  id                    Int               @id @default(autoincrement())
  requestId             Int
  itemId                Int
  requestedQty          Int
  approvedQty           Int?
  deliveredQty          Int               @default(0)
  returnedQty           Int               @default(0)
  physicalStateApproved PhysicalState     @default(OPERATIVO)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  request          Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item             Item              @relation(fields: [itemId], references: [id])
  assignedUnits    RequestItemUnit[]

  @@index([requestId])
  @@index([itemId])
  @@map("request_items")
}

model RequestItemUnit {
  id                    Int             @id @default(autoincrement())
  requestItemId         Int
  inventoryUnitId       Int
  loanedAt              DateTime?
  returnedAt            DateTime?
  returnedById          Int?
  physicalStateReturned PhysicalState?
  // RN-PRE-05 / RN-PRE-10: condición de retorno por unidad devuelta (dos ejes + descripción).
  returnFunctioning     ReturnFunctioning?
  returnDamageState     ReturnDamageState?
  returnDescription     String?         @db.Text
  // RN-PRE-15 / RN-PRE-16: pérdida declarada de una unidad prestada (distinta de no devuelta).
  lostAt                DateTime?
  lostById              Int?
  lostReason            String?         @db.Text
  createdAt             DateTime        @default(now())

  requestItem      RequestItem    @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  inventoryUnit    InventoryUnit  @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  returnedBy       User?          @relation("ReturnedByUser", fields: [returnedById], references: [id])
  lostBy           User?          @relation("LostByUser", fields: [lostById], references: [id])
  damageTasks      DamageTask[]

  @@unique([requestItemId, inventoryUnitId])
  @@index([requestItemId])
  @@index([inventoryUnitId])
  @@index([returnedById])
  @@map("request_item_units")
}

model Movement {
  id              Int          @id @default(autoincrement())
  type            MovementType
  itemId          Int?
  inventoryUnitId Int?
  quantity        Int          @default(0)
  responsibleId   Int?
  requestId       Int?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())

  item          Item?           @relation(fields: [itemId], references: [id])
  inventoryUnit InventoryUnit?  @relation(fields: [inventoryUnitId], references: [id])
  responsible   User?           @relation("MovementResponsible", fields: [responsibleId], references: [id])
  request       Request?        @relation(fields: [requestId], references: [id])

  @@index([itemId])
  @@index([inventoryUnitId])
  @@index([requestId])
  @@index([createdAt])
  @@map("movements")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType @default(SYSTEM)
  title     String           @db.VarChar(255)
  message   String           @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// RN-PRE-06 / RN-PRE-09: tarea pendiente visible para el administrador cuando algo vuelve
// dañado, no funciona o le falta una pieza. Sin consecuencia para el instructor.
model DamageTask {
  id               Int              @id @default(autoincrement())
  inventoryUnitId  Int
  requestItemUnitId Int?
  description      String           @db.Text
  status           DamageTaskStatus @default(OPEN)
  createdById      Int?
  resolvedById     Int?
  resolvedAt       DateTime?
  resolutionNote   String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  inventoryUnit   InventoryUnit    @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  requestItemUnit RequestItemUnit? @relation(fields: [requestItemUnitId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("DamageTaskCreatedBy", fields: [createdById], references: [id])
  resolvedBy      User?            @relation("DamageTaskResolvedBy", fields: [resolvedById], references: [id])

  @@index([inventoryUnitId])
  @@index([status])
  @@map("damage_tasks")
}
